APP_NAME="JAOB Dashboard"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Kolkata
APP_URL=http://localhost:8000

# If this app is deployed in a subfolder such as yourdomain.com/dashboard,
# set APP_URL accordingly, e.g. https://jaobonline.org/dashboard
# and make sure the folder is pointed to by its own document root or a subfolder Apache config (see README).

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=jaob_dashboard
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=180
SESSION_ENCRYPT=false

CACHE_STORE=file
QUEUE_CONNECTION=sync

FILESYSTEM_DISK=public

# Mail is optional (only needed if you later choose to email credentials to students).
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@jaobonline.org"
MAIL_FROM_NAME="${APP_NAME}"

# Institute details used on generated PDFs (marksheet / admit card / fee receipt)
INSTITUTE_NAME="JAOB"
INSTITUTE_FULL_NAME="Jharkhand Academic and Occupational Board"
INSTITUTE_ADDRESS="Bokaro, Jharkhand, India"
